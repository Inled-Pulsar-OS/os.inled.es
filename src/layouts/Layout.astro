---
// Base Layout for Pulsar OS Web (Landing Only)
// Layout Base para la Web de Pulsar OS (Solo Landing)
import "../styles/global.css";

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "Pulsar OS is a community-driven, 100% auditable operating system designed to replicate macOS (Pear) and Windows (Wintux) workflows.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />

        <!-- Favicon using remote logo link / Favicon usando enlace de logo remoto -->
        <link
            rel="icon"
            type="image/svg+xml"
            href="https://hosted.inled.es/pulsar-logo-simple-sf.png"
        />

        <title>{title} — Pulsar OS</title>

        <!-- Google Fonts: Space Grotesk and Inter / Fuentes de Google Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        <!-- Font Awesome 6 (for Discord icon) -->
        <link
            rel="stylesheet"
            href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
            crossorigin="anonymous"
        />

        <!-- Theme prevention script: defaults to light (warm cream) / Script de prevención de tema: por defecto claro (crema cálido) -->
        <script is:inline>
            // Run immediately before DOM rendering / Ejecutar inmediatamente antes de que el DOM se renderice
            (function () {
                const savedTheme = localStorage.getItem("theme");
                const prefersDark = window.matchMedia(
                    "(prefers-color-scheme: dark)",
                ).matches;
                if (savedTheme === "dark" || (!savedTheme && prefersDark)) {
                    document.documentElement.classList.add("dark");
                } else {
                    document.documentElement.classList.remove("dark");
                }
            })();
        </script>
    </head>
    <body>
        <!-- Floating Header / Cabecera Flotante (Inspired by Star Labs navigation layout) -->
        <header class="floating-header">
            <div class="container header-container">
                <a href="/" class="logo-container">
                    <!-- Logo points to the remote URL as requested / El logo apunta a la URL remota requerida -->
                    <img
                        src="https://hosted.inled.es/pulsar-logo-simple-sf.png"
                        alt="Pulsar OS Logo"
                        class="logo-img"
                    />
                    <span class="logo-text">Pulsar OS</span>
                </a>

                <nav class="nav-links">
                    <a href="#hero" class="nav-link">Home</a>
                    <a href="/pear-edition" class="nav-link">Pear Edition</a>
                    <a href="#features" class="nav-link">Features</a>
                    <a href="/community" class="nav-link">Community</a>
                    <a href="https://github.com/Inled-Pulsar-OS/DOCS/wiki" target="_blank" rel="noopener noreferrer" class="nav-link">Docs</a>
                </nav>

                <div class="header-actions">
                    <!-- Theme Toggle Button / Botón de cambio de tema -->
                    <button
                        id="theme-toggle"
                        class="theme-toggle-btn"
                        aria-label="Toggle light or dark theme"
                    >
                        <!-- Sun Icon (shown in dark mode) / Icono de Sol (se muestra en modo oscuro) -->
                        <svg
                            class="sun-icon"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <circle cx="12" cy="12" r="5"></circle>
                            <line x1="12" y1="1" x2="12" y2="3"></line>
                            <line x1="12" y1="21" x2="12" y2="23"></line>
                            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"
                            ></line>
                            <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
                            ></line>
                            <line x1="1" y1="12" x2="3" y2="12"></line>
                            <line x1="21" y1="12" x2="23" y2="12"></line>
                            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
                            ></line>
                            <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"
                            ></line>
                        </svg>
                        <!-- Moon Icon (shown in light mode) / Icono de Luna (se muestra en modo claro) -->
                        <svg
                            class="moon-icon"
                            width="20"
                            height="20"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path
                                d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
                            ></path>
                        </svg>
                    </button>

                    <a
                        href="https://link.inled.es/discord"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-icon btn-nav-icon"
                        aria-label="Discord"
                    >
                        <i class="fa-brands fa-discord"></i>
                    </a>
                    <a
                        href="https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-icon btn-nav-icon"
                        aria-label="Matrix"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            viewBox="0 0 512 512"
                            width="18"
                            height="18"
                        >
                            <path
                                fill="currentColor"
                                d="M61.6 27l-32.9 0 0 458 32.9 0 0 11-45.6 0 0-480 45.6 0 0 11zM496 496l-45.6 0 0-11 32.9 0 0-458-32.9 0 0-11 45.6 0 0 480zM324.1 167.6c9 0 17.4 1.1 25.2 3.3s14.3 5.7 19.8 10.6 9.8 11.2 12.9 19c3 7.8 4.6 17.3 4.6 28.3l0 114.5-47 0 0-97c0-5.7-.2-11.2-.6-16.3s-1.7-9.5-3.6-13.2c-2-3.8-4.9-6.8-8.7-9s-9.1-3.3-15.7-3.3c-6.6 0-12 1.3-16.1 3.8-4.1 2.6-7.3 5.8-9.6 10-2.3 4.1-3.9 8.7-4.6 13.9-.7 5.2-1.2 10.4-1.2 15.7l0 95.3-47 0 0-96c0-5.1-.1-10.1-.4-15-.2-5-1.2-9.5-2.9-13.8-1.7-4.1-4.4-7.6-8.3-10.1s-9.5-3.8-17.1-3.8c-2.2 0-5.2 .5-8.8 1.5s-7.2 2.9-10.6 5.6-6.4 6.7-8.8 11.9-3.6 12-3.6 20.4l0 99.3-47 0 0-171.3 44.3 0 0 23.2 .7 0c6.2-8.9 13.7-15.7 22.3-20.5 8.7-4.9 18.7-7.3 30-7.3 10.8 0 20.7 2.1 29.6 6.3s15.7 11.6 20.4 22.2c5.1-7.5 12-14.1 20.7-19.8s19-8.6 30.9-8.6z"
                            />
                        </svg>
                    </a>
                    <a
                        href="https://github.com/Inled-Pulsar-OS/ISO/releases/latest"
                        target="_blank"
                        rel="noopener noreferrer"
                        data-download-warn
                        class="btn btn-primary btn-nav-download"
                        >Download</a
                    >

                    <!-- Hamburger Menu Button / Botón de menú hamburguesa -->
                    <button
                        id="menu-toggle"
                        class="menu-toggle-btn"
                        aria-label="Toggle navigation menu"
                    >
                        <svg
                            class="menu-icon"
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="3" y1="6" x2="21" y2="6"></line>
                            <line x1="3" y1="12" x2="21" y2="12"></line>
                            <line x1="3" y1="18" x2="21" y2="18"></line>
                        </svg>
                        <svg
                            class="close-icon"
                            width="22"
                            height="22"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Mobile Navigation Menu / Menú de navegación móvil -->
            <nav id="mobile-nav" class="mobile-nav">
                <a href="#hero" class="mobile-nav-link" onclick="closeMobileMenu()">Home</a>
                <a href="/pear-edition" class="mobile-nav-link" onclick="closeMobileMenu()">Pear Edition</a>
                <a href="#features" class="mobile-nav-link" onclick="closeMobileMenu()">Features</a>
                <a href="/community" class="mobile-nav-link" onclick="closeMobileMenu()">Community</a>
                <a href="https://github.com/Inled-Pulsar-OS/DOCS/wiki" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" onclick="closeMobileMenu()">Docs</a>
                <a href="https://link.inled.es/discord" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" onclick="closeMobileMenu()">Discord</a>
                <a href="https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org" target="_blank" rel="noopener noreferrer" class="mobile-nav-link" onclick="closeMobileMenu()">Matrix</a>
            </nav>
        </header>

        <!-- Page Content Slot / Contenedor principal de contenido -->
        <main class="main-content">
            <slot />
        </main>

        <!-- Footer / Pie de Página -->
        <footer class="site-footer">
            <div class="container footer-container">
                <div class="footer-left">
                    <a href="/" class="footer-logo">
                        <img
                            src="https://hosted.inled.es/pulsar-logo-simple-sf.png"
                            alt="Pulsar OS Logo"
                            class="logo-img-small"
                        />
                        <span>Pulsar OS</span>
                    </a>
                    <!-- <p class="footer-copy">
                        Pulsar OS is made by <a href="https://inled.es"
                            >Inled Group</a
                        >, founded by <a href="https://jaimegh.com">JaimeGH</a>
                    </p> -->
                </div>
                <div class="footer-right">
                    <a
                        href="https://github.com/Inled-Pulsar-OS"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link">GitHub</a
                    >
                    <div></div>
                    <a
                        href="https://github.com/orgs/Inled-Pulsar-OS/projects/1"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="footer-link">Projects</a
                    >
                    <a href="/community" class="footer-link">Community</a>
                    <a href="/community/contributors" class="footer-link">Wall</a>
                </div>
            </div>
            <div class="container">
                <p class="footer-disclaimer">
                    Images shown are for illustration purposes only and may not
                    reflect the final product. Non-contractual visuals.
                </p>
            </div>
        </footer>

        <!-- Alpha download warning dialog / Diálogo de aviso de descarga alpha -->
        <dialog id="alpha-dialog" class="alpha-dialog">
            <div class="alpha-dialog-content">
                <h3 class="alpha-dialog-title">Pear Edition is in alpha</h3>
                <p class="alpha-dialog-text">
                    We are starting to offer it openly, but it is still in testing.
                    We recommend trying it in a virtual machine and checking the
                    GitHub project for known errors before using it on real hardware.
                </p>
                <div class="alpha-dialog-actions">
                    <a
                        href="https://github.com/orgs/Inled-Pulsar-OS/projects/1"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary"
                    >
                        View GitHub project
                    </a>
                    <a
                        href="/iso"
                        class="btn btn-primary"
                        >Continue to download</a
                    >
                </div>
                <button
                    type="button"
                    class="alpha-dialog-cancel"
                    data-close-dialog
                >
                    Cancel
                </button>
            </div>
        </dialog>

        <!-- Theme handler + mobile menu logic / Lógica de control de temas y menú móvil -->
        <script>
            const themeToggle = document.getElementById("theme-toggle");

            themeToggle?.addEventListener("click", () => {
                const isDark =
                    document.documentElement.classList.toggle("dark");
                localStorage.setItem("theme", isDark ? "dark" : "light");
            });

            const menuToggle = document.getElementById("menu-toggle");
            const mobileNav = document.getElementById("mobile-nav");

            menuToggle?.addEventListener("click", () => {
                menuToggle.classList.toggle("open");
                mobileNav?.classList.toggle("open");
            });

            function closeMobileMenu() {
                menuToggle?.classList.remove("open");
                mobileNav?.classList.remove("open");
            }

            const alphaDialog = document.getElementById("alpha-dialog");

            document.querySelectorAll("[data-download-warn]").forEach((btn) => {
                btn.addEventListener("click", (event) => {
                    event.preventDefault();
                    alphaDialog?.showModal();
                });
            });

            document.querySelectorAll("[data-close-dialog]").forEach((btn) => {
                btn.addEventListener("click", () => alphaDialog?.close());
            });

            alphaDialog?.addEventListener("click", (event) => {
                if (event.target === alphaDialog) alphaDialog.close();
            });
        </script>
    </body>
</html>

<style>
    /* Header styling / Estilos de cabecera */

    .floating-header {
        position: fixed;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        width: calc(100% - 40px);
        max-width: var(--max-width);
        height: 70px;
        background: rgba(246, 244, 238, 0.75); /* Warm light blur */
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        z-index: 100;
        transition: all var(--transition-speed) ease;
    }

    html.dark .floating-header {
        background: rgba(13, 11, 21, 0.75); /* Dark theme blur */
    }

    .floating-header:hover {
        border-color: var(--border-focus);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    html.dark .floating-header:hover {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .header-container {
        height: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 24px;
    }

    .logo-container {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .logo-img {
        height: 36px;
        width: auto;
    }

    .logo-text {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: -0.5px;
        color: var(--text-primary);
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 32px;
    }

    .nav-link {
        font-family: var(--font-body);
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--text-secondary);
        transition: color var(--transition-speed) ease;
    }

    .nav-link:hover {
        color: var(--text-primary);
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    /* Theme toggle styling / Estilos de botón de tema */
    .theme-toggle-btn {
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        width: 40px;
        height: 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all var(--transition-speed) ease;
    }

    .theme-toggle-btn:hover {
        background: var(--bg-card-hover);
        border-color: var(--border-focus);
    }

    /* Sun/moon icon visibility rules based on .dark class on html */
    .sun-icon {
        display: none;
    }

    .moon-icon {
        display: block;
    }

    html.dark .sun-icon {
        display: block;
    }

    html.dark .moon-icon {
        display: none;
    }

    .btn-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        color: var(--text-primary);
        transition: all var(--transition-speed) ease;
        text-decoration: none;
    }

    .btn-icon:hover {
        background: var(--bg-card-hover);
        border-color: var(--border-focus);
    }

    .btn-nav-download {
        padding: 10px 22px;
        font-size: 0.85rem;
    }

    /* Content area margins for floating header / Márgenes del contenido para cabecera flotante */
    .main-content {
        min-height: 80vh;
        padding-top: 120px;
    }

    /* Footer styles / Estilos del pie de página */
    .site-footer {
        border-top: 1px solid var(--border-color);
        padding: 40px 0;
        margin-top: 80px;
        background-color: rgba(233, 230, 220, 0.2);
    }

    html.dark .site-footer {
        background-color: rgba(23, 20, 36, 0.2);
    }

    .footer-disclaimer {
        color: var(--text-secondary);
        font-size: 0.8rem;
        text-align: center;
        margin-top: 24px;
        opacity: 0.7;
    }

    .footer-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .footer-left {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .footer-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        font-family: var(--font-display);
        font-weight: 700;
        color: var(--text-primary);
        font-size: 1.1rem;
    }

    .logo-img-small {
        height: 24px;
        width: auto;
    }

    .footer-copy {
        color: var(--text-secondary);
        font-size: 0.85rem;
    }

    .footer-links {
        display: flex;
        gap: 24px;
    }

    .footer-link {
        color: var(--text-secondary);
        font-size: 0.9rem;
        transition: color var(--transition-speed) ease;
    }

    .footer-link:hover {
        color: var(--text-primary);
    }

    /* Hamburger menu button / Botón de menú hamburguesa */
    .menu-toggle-btn {
        display: none;
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        width: 40px;
        height: 40px;
        border-radius: 12px;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all var(--transition-speed) ease;
    }

    .menu-toggle-btn:hover {
        background: var(--bg-card-hover);
        border-color: var(--border-focus);
    }

    .close-icon {
        display: none;
    }

    .menu-toggle-btn.open .menu-icon {
        display: none;
    }

    .menu-toggle-btn.open .close-icon {
        display: block;
    }

    /* Mobile navigation panel / Panel de navegación móvil */
    .mobile-nav {
        display: none;
        position: absolute;
        top: calc(100% + 8px);
        left: 0;
        right: 0;
        background: var(--bg-color);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        padding: 16px;
        flex-direction: column;
        gap: 4px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    html.dark .mobile-nav {
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .mobile-nav.open {
        display: flex;
    }

    .mobile-nav-link {
        display: block;
        padding: 12px 16px;
        border-radius: 10px;
        font-family: var(--font-body);
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--text-secondary);
        transition: all var(--transition-speed) ease;
    }

    .mobile-nav-link:hover {
        background: var(--bg-card-hover);
        color: var(--text-primary);
    }

    /* Alpha download dialog / Diálogo de aviso de descarga */
    .alpha-dialog {
        border: 1px solid var(--border-color);
        border-radius: 24px;
        background-color: var(--bg-card);
        color: var(--text-primary);
        padding: 40px;
        max-width: 460px;
        width: calc(100% - 48px);
        margin: auto;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
    }

    .alpha-dialog::backdrop {
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
    }

    .alpha-dialog-content {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .alpha-dialog-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.5px;
        margin-bottom: 12px;
        color: var(--text-primary);
    }

    .alpha-dialog-text {
        color: var(--text-secondary);
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 28px;
    }

    .alpha-dialog-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
        width: 100%;
    }

    .alpha-dialog-cancel {
        margin-top: 20px;
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-family: var(--font-body);
        font-size: 0.85rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: underline;
        transition: color var(--transition-speed) ease;
    }

    .alpha-dialog-cancel:hover {
        color: var(--text-primary);
    }

    /* Responsive styling / Estilos responsivos */
    @media (max-width: 800px) {
        .nav-links {
            display: none;
        }

        .menu-toggle-btn {
            display: flex;
        }

        .btn-nav-download,
        .btn-nav-icon {
            display: none;
        }

        .footer-container {
            flex-direction: column;
            text-align: center;
            align-items: center;
        }

        .footer-left {
            align-items: center;
        }
    }
</style>
