---
// Homepage / Página de inicio
// A friendly, Fedora-style landing: logo + plain-language purpose,
// clickable flavour cards, and a simple way in for non-technical users.
// El inicio es la puerta de entrada: lista los flavours, comunidad y docs.
// Copy is deliberately non-technical: we sell "it feels like home",
// not package managers or desktop environments.
import Layout from "../layouts/Layout.astro";
import FeatureList from "../components/FeatureList.astro";

const DISCORD = "https://link.inled.es/discord";
const MATRIX = "https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org";
const TELEGRAM = "https://link.inled.es/telegram";

// Feature icons (inline SVG, 24x24 feather-style) / Iconos de las features
const I = {
    session: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9"></path><polyline points="3 4 3 9 8 9"></polyline><path d="M12 7v5l3 3"></path></svg>`,
    sayri: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a7 7 0 0 1 7 7c0 2.4-1.2 4.1-2.5 5.4-.9.9-1.5 2-1.5 3.1V19a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2v-1.5c0-1.1-.6-2.2-1.5-3.1C6.2 13.1 5 11.4 5 9a7 7 0 0 1 7-7z"></path><line x1="9.5" y1="21" x2="14.5" y2="21"></line></svg>`,
    windows: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"></rect><line x1="3" y1="10" x2="21" y2="10"></line><circle cx="6.5" cy="7" r="0.5"></circle><circle cx="9" cy="7" r="0.5"></circle></svg>`,
    store: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M2 9h20"></path><path d="M9 20V9"></path></svg>`,
    finder: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`,
    spotlight: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>`,
    circle: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7" stroke-dasharray="4 3"></circle><line x1="16.2" y1="16.2" x2="21" y2="21"></line></svg>`,
    cloud: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19a4.5 4.5 0 1 0-.42-8.98 6 6 0 1 0-11.06 3.1A3.5 3.5 0 0 0 7 19.91"></path><path d="M8 16l4-4 4 4"></path><path d="M12 12v9"></path></svg>`,
    backup: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="12" x2="2" y2="12"></line><path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path><line x1="6" y1="16" x2="6.01" y2="16"></line><line x1="10" y1="16" x2="10.01" y2="16"></line></svg>`,
    shield: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
    keyboard: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"></rect><path d="M6 10h.01"></path><path d="M10 10h.01"></path><path d="M14 10h.01"></path><path d="M18 10h.01"></path><path d="M7 14h10"></path></svg>`,
    wallpaper: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><path d="M21 15l-5-5L5 21"></path></svg>`,
};

const FEATURES = [
    {
        iconSvg: I.session,
        title: "Session restore",
        desc: 'Shut down choosing "save session", and when you come back everything is exactly where you left it. Every window, every app, just as they were.',
    },
    {
        iconSvg: I.sayri,
        title: "Sayri, the built-in assistant",
        desc: "Ask in plain language and it gets things done on your computer. Connect whichever AI provider you want, or run it fully on your machine. Siri has never been this smart — or this private.",
    },
    {
        iconSvg: I.windows,
        title: "Windows that behave like they should",
        desc: "Snapping, Stage-style grouping and multitouch gestures that feel natural — the way you already organise your screen on a Mac, now on Linux.",
    },
    {
        iconSvg: I.store,
        title: "One app store for everything",
        desc: "Install any app, however it is packaged: Flathub, .deb, pacman, AUR. Search, click, done — no terminal, no reading forums at midnight.",
    },
    {
        iconSvg: I.finder,
        title: "Finder, rebuilt",
        desc: "The file manager you already know: Mac-style navigation, previews, tags and a sidebar that feels familiar from the first click.",
    },
    {
        iconSvg: I.spotlight,
        title: "Spotlight search",
        desc: "Press one key and search anything: apps, documents, files, even actions inside apps. Type, hit enter, done.",
    },
    {
        iconSvg: I.circle,
        title: "Circle to Search",
        desc: "Shake the cursor, circle anything on your screen and search it on Google, ask Sayri about it, or grab the text with OCR.",
    },
    {
        iconSvg: I.cloud,
        title: "Your clouds, in the file manager",
        desc: "Google Drive, Dropbox, OneDrive, Nextcloud and more than 50 other providers, right where your files live.",
    },
    {
        iconSvg: I.backup,
        title: "Time Machine",
        desc: "Copies of your whole system, stored wherever you like: a network server, one of the 50 cloud providers, a USB stick. If your computer ever breaks, put everything back from recovery.",
    },
    {
        iconSvg: I.shield,
        title: "Recovery, built in",
        desc: "Repair, reset or roll back the system from recovery: over the internet, even if it won't start, or from a USB stick. No reinstalling from scratch.",
    },
    {
        iconSvg: I.keyboard,
        title: "Your keyboard, your rules",
        desc: "Team Mac shortcuts, or the classic Ctrl+C? Switch the whole keyboard between Mac style and Linux style in one place.",
    },
    {
        iconSvg: I.wallpaper,
        title: "Live wallpapers",
        desc: "A desktop that feels alive: moving wallpapers on your desktop and on the login screen.",
    },
];

const COMPAT = [
    {
        icon: "https://hosted.inled.es/macboat.png",
        title: "MacBoat",
        desc: "Run real macOS on this same computer, downloaded straight from Apple's own servers. No hassle.",
    },
    {
        icon: "https://hosted.inled.es/winboat_logo.NqN8dmd9.svg",
        title: "WinBoat",
        desc: "Windows apps open as normal windows on your desktop. A real Windows underneath, without the awkwardness.",
    },
    {
        icon: "https://hosted.inled.es/droidtux.png",
        title: "DroidTux",
        desc: "Your Android apps, running in their own windows on the big screen.",
    },
    {
        icon: "https://hosted.inled.es/gsconnect.png",
        title: "GSConnect",
        desc: "Notifications, files and messages flowing between your phone and your computer.",
    },
];

const CONTRIBUTORS = [
    {
        name: "JaimeGH",
        role: "Founder and developer of the project",
        avatar: "/assets/people/jaimegh.png",
        discord: "https://discord.com/users/1383822429851222150",
        discordUser: "jaimegh_es",
        github: "https://github.com/jaimegh-es",
    },
    {
        name: "Victor1890",
        role: "Daily contributor. Built the Bitten Fruit landing",
        avatar: "/assets/people/victor1890.png",
        discord: "https://discord.com/users/1111731625663926382",
        discordUser: "vitico1890",
        github: "https://github.com/Victor1890",
    },
    {
        name: "hhh",
        role: "Creator of a lot of apps for the Pulsar Store + first Sayri prototype on SDL",
        avatar: "/assets/people/hhh.png",
        discord: "https://discord.com/users/1237308179566690345",
        discordUser: "hhh092470",
        github: null,
    },
];
---

<Layout pageKey="index">
    <!-- Hero / Héroe -->
    <section id="hero" class="home-hero" aria-label="Pulsar OS introduction">
        <div class="container home-hero-inner">
            <img
                src="https://hosted.inled.es/pulsar-logo-simple-sf.png"
                alt="Pulsar OS logo"
                class="home-logo"
            />
            <h1 class="home-title">Pulsar OS</h1>
            <p class="home-lead">
                Linux that is so easy, you already know how to use it: each
                edition copies the system you know. And with the total freedom
                only Linux gives.
            </p>
            <div class="home-hero-actions">
                <a href="#flavours" class="btn btn-primary">
                    Choose yours
                    <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
                <a href="/new-to-linux" class="btn btn-secondary">Never used Linux? Start here</a>
            </div>
        </div>
    </section>

    <!-- Flavours: the main event / Los flavours: lo principal -->
    <section id="flavours" class="home-flavours" aria-label="Pulsar OS editions">
        <div class="container">
            <h2 class="section-title">Which one feels like home?</h2>
            <p class="section-subtitle">
                Each edition is a full operating system with its own personality.
                Try it from a USB stick with zero commitment, or install it when
                you are ready.
            </p>

            <div class="home-flavour-grid">
                <a href="/bitten-fruit/" class="home-flavour-card">
                    <img
                        src="https://hosted.inled.es/pulsar-mac.png"
                        alt="Bitten Fruit logo"
                        class="home-flavour-logo"
                    />
                    <div class="home-flavour-body">
                        <h3 class="home-flavour-name">Bitten Fruit</h3>
                        <p class="home-flavour-desc">
                            Linux made easy for Mac users: the same desktop, the
                            same flow you already know, nothing to relearn. And
                            with the total freedom of Linux.
                        </p>
                        <span class="home-flavour-link">
                            Show me
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </span>
                    </div>
                </a>

                <article class="home-flavour-card is-soon">
                    <div class="home-flavour-logo home-flavour-placeholder" aria-hidden="true">
                        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <div class="home-flavour-body">
                        <h3 class="home-flavour-name">Wintux</h3>
                        <p class="home-flavour-desc">
                            The Windows flow you already know, minus the nagging:
                            no accounts, no surprises. Easy Linux for PC users.
                            On its way.
                        </p>
                    </div>
                </article>

                <article class="home-flavour-card is-soon">
                    <div class="home-flavour-logo home-flavour-placeholder" aria-hidden="true">
                        <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                    </div>
                    <div class="home-flavour-body">
                        <h3 class="home-flavour-name">Tube OS</h3>
                        <p class="home-flavour-desc">
                            Turn that old computer into the center of the living
                            room: series, films and your files on the TV, easy as
                            a remote control. Still cooking.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- Innovation: the whole flow, not a theme / Innovación: el flujo entero, no solo un tema -->
    <section class="home-innovation" aria-label="What makes Pulsar OS different">
        <div class="container">
            <h2 class="section-title">Not just a theme. The whole flow.</h2>
            <p class="section-subtitle">
                Other Linux systems dress up the same old desktop. Bitten Fruit
                rebuilds how everything works and adds things Linux has never
                had. This is what ships today.
            </p>

            <FeatureList items={FEATURES} />

<h3 class="home-innovation-subhead">And it gets along with your other systems</h3>

            <FeatureList items={COMPAT} />

<p class="home-innovation-note">
                All of this ships in <strong>Bitten Fruit</strong>, the edition
                available today, and it is completely free.
            </p>
            <a class="home-innovation-more" href="/bitten-fruit/">
                See everything Bitten Fruit can do
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </section>

    <!-- Why Pulsar OS, plain talk / Por qué Pulsar OS, en cristiano -->
    <section class="home-why" aria-label="Why Pulsar OS">
        <div class="container">
            <div class="home-why-grid">
                <div class="home-why-item">
                    <h3>Easy from minute one</h3>
                    <p>
                        Each edition copies the flow of a system you already use.
                        Your icons, your habits, your way of working. Nothing to
                        relearn.
                    </p>
                </div>
                <div class="home-why-item">
                    <h3>Total freedom</h3>
                    <p>
                        The freedom only Linux gives: no licences, no subscriptions,
                        no "activate your product". Put it on every computer you
                        own.
                    </p>
                </div>
                <div class="home-why-item">
                    <h3>Nothing hidden inside</h3>
                    <p>
                        Everything the system does is published for anyone to read.
                        If it is on your computer, it is because you decided so.
                    </p>
                </div>
                <div class="home-why-item">
                    <h3>Real people behind it</h3>
                    <p>
                        We hang out with the community every day. Ask anything,
                        there are no dumb questions, and we answer in English and
                        Spanish.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contributors / Contribuidores -->
    <section class="home-contributors" aria-label="People behind Pulsar OS">
        <div class="container">
            <h2 class="section-title">The people behind it</h2>
            <p class="section-subtitle">
                Real humans build Pulsar OS, in the open. Say hi on Discord —
                they actually answer.
            </p>

            <div class="home-contributors-grid">
                {CONTRIBUTORS.map((person) => (
                    <div class="home-contributor-card">
                        <img
                            src={person.avatar}
                            alt={`${person.name} avatar`}
                            class="home-contributor-avatar"
                            width="72"
                            height="72"
                            loading="lazy"
                        />
                        <div class="home-contributor-name">{person.name}</div>
                        <div class="home-contributor-role">{person.role}</div>
                        <div class="home-contributor-links">
                            <a
                                href={person.discord}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="home-contributor-link"
                                aria-label={`${person.name} on Discord (@${person.discordUser})`}
                            >
                                <i class="fa-brands fa-discord" aria-hidden="true"></i>
                                <span>{person.discordUser}</span>
                            </a>
                            {person.github && (
                                <a
                                    href={person.github}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="home-contributor-link"
                                    aria-label={`${person.name} on GitHub`}
                                >
                                    <i class="fa-brands fa-github" aria-hidden="true"></i>
                                    <span>GitHub</span>
                                </a>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- Community / Comunidad -->
    <section class="home-community" aria-label="Community">
        <div class="container">
            <div class="home-community-card">
                <div class="home-community-text">
                    <h2 class="home-community-title">Talk to the humans behind it</h2>
                    <p class="home-community-desc">
                        Stuck installing? Curious about something? Just want to
                        say hi? We are around every day, and someone will answer.
                    </p>
                </div>
                <div class="home-community-channels">
                    <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="home-channel">
                        <span class="home-channel-icon"><i class="fa-brands fa-discord"></i></span>
                        <span class="home-channel-name">Discord</span>
                        <span class="home-channel-desc">The busiest room. English and Spanish.</span>
                    </a>
                    <a href={MATRIX} target="_blank" rel="noopener noreferrer" class="home-channel">
                        <span class="home-channel-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="18" height="18" aria-hidden="true">
                                <path fill="currentColor" d="M61.6 27l-32.9 0 0 458 32.9 0 0 11-45.6 0 0-480 45.6 0 0 11zM496 496l-45.6 0 0-11 32.9 0 0-458-32.9 0 0-11 45.6 0 0 480zM324.1 167.6c9 0 17.4 1.1 25.2 3.3s14.3 5.7 19.8 10.6 9.8 11.2 12.9 19c3 7.8 4.6 17.3 4.6 28.3l0 114.5-47 0 0-97c0-5.7-.2-11.2-.6-16.3s-1.7-9.5-3.6-13.2c-2-3.8-4.9-6.8-8.7-9s-9.1-3.3-15.7-3.3c-6.6 0-12 1.3-16.1 3.8-4.1 2.6-7.3 5.8-9.6 10-2.3 4.1-3.9 8.7-4.6 13.9-.7 5.2-1.2 10.4-1.2 15.7l0 95.3-47 0 0-96c0-5.1-.1-10.1-.4-15-.2-5-1.2-9.5-2.9-13.8-1.7-4.1-4.4-7.6-8.3-10.1s-9.5-3.8-17.1-3.8c-2.2 0-5.2 .5-8.8 1.5s-7.2 2.9-10.6 5.6-6.4 6.7-8.8 11.9-3.6 12-3.6 20.4l0 99.3-47 0 0-171.3 44.3 0 0 23.2 .7 0c6.2-8.9 13.7-15.7 22.3-20.5 8.7-4.9 18.7-7.3 30-7.3 10.8 0 20.7 2.1 29.6 6.3s15.7 11.6 20.4 22.2c5.1-7.5 12-14.1 20.7-19.8s19-8.6 30.9-8.6z"></path>
                            </svg>
                        </span>
                        <span class="home-channel-name">Matrix</span>
                        <span class="home-channel-desc">Open and lightweight, for the curious.</span>
                    </a>
                    <a href={TELEGRAM} target="_blank" rel="noopener noreferrer" class="home-channel">
                        <span class="home-channel-icon"><i class="fa-brands fa-telegram"></i></span>
                        <span class="home-channel-name">Telegram</span>
                        <span class="home-channel-desc">Quick questions and news.</span>
                    </a>
                    <a href="https://github.com/Inled-Pulsar-OS" target="_blank" rel="noopener noreferrer" class="home-channel">
                        <span class="home-channel-icon"><i class="fa-brands fa-github"></i></span>
                        <span class="home-channel-name">GitHub</span>
                        <span class="home-channel-desc">Peek at how it is all made.</span>
                    </a>
                    <a href="/community" class="home-channel">
                        <span class="home-channel-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </span>
                        <span class="home-channel-name">Community</span>
                        <span class="home-channel-desc">Ideas, bugs and the roadmap.</span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
