---
// Edition-picker homepage on the shared layout / Inicio selector de ediciones
// sobre el layout compartido. Apple-style picker: title, the available
// edition (Bitten Fruit) and a dimmed upcoming row. Hovering the available
// card runs a 3s countdown ring, then opens its site.
// Selector estilo Apple: título, la edición disponible (Bitten Fruit) y una
// fila atenuada con las que llegan pronto. Al pasar el ratón por la tarjeta
// disponible corre un anillo de 3s que abre su web.
import Layout from "../layouts/Layout.astro";

const BITTEN_FRUIT = "https://bittenfruit.inled.es";

// Available editions / Ediciones disponibles
const AVAILABLE = [
    {
        name: "Bitten Fruit",
        desc: "The macOS experience on Linux.",
        logo: "https://hosted.inled.es/pulsar-mac.png",
        href: BITTEN_FRUIT,
    },
];

// Upcoming editions: shown disabled / En camino: se muestran desactivadas
const UPCOMING = [
    {
        name: "Wintux",
        desc: "The Windows flow you know, minus the nagging.",
        logo: "https://hosted.inled.es/cdn/pulsar-win11-nobg.png",
    },
    {
        name: "Tube OS",
        desc: "Turn an old computer into the center of the living room.",
        logo: "https://hosted.inled.es/cdn/tube-os-simple-sf.png",
    },
];
---

<Layout pageKey="index">
    <main class="picker">
        <header class="picker-head">
            <h1>Pulsar OS</h1>
            <p>Choose your edition.</p>
        </header>

        <ul class="editions">
            {AVAILABLE.map((edition) => (
                <li class="edition">
                    <a class="edition-card" href={edition.href} data-url={edition.href}>
                        <img
                            src={edition.logo}
                            alt=""
                            width="64"
                            height="64"
                            class="edition-logo"
                            loading="eager"
                        />
                        <h2 class="edition-name">{edition.name}</h2>
                        <p class="edition-desc">{edition.desc}</p>
                        <span class="edition-cta">
                            Go to bittenfruit.inled.es
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </span>

                        <!-- Hover countdown ring / Anillo de cuenta atrás -->
                        <span class="card-timer" aria-hidden="true">
                            <svg width="52" height="52" viewBox="0 0 52 52">
                                <circle class="timer-track" cx="26" cy="26" r="20" />
                                <circle
                                    class="timer-progress"
                                    cx="26"
                                    cy="26"
                                    r="20"
                                    stroke-dasharray="125.66"
                                    stroke-dashoffset="125.66"
                                />
                            </svg>
                        </span>
                    </a>
                </li>
            ))}
        </ul>

        <section class="upcoming" aria-label="Upcoming editions">
            <p class="upcoming-caption">Coming soon</p>
            <ul class="editions">
                {UPCOMING.map((edition) => (
                    <li class="edition">
                        <div class="edition-card edition-soon" aria-disabled="true">
                            <img
                                src={edition.logo}
                                alt=""
                                width="64"
                                height="64"
                                class="edition-logo"
                                loading="lazy"
                            />
                            <h2 class="edition-name">{edition.name}</h2>
                            <p class="edition-desc">{edition.desc}</p>
                        </div>
                    </li>
                ))}
            </ul>
        </section>
    </main>
</Layout>

<script>
    // Hover-to-open: after 3s hovering a linked card, go to its site.
    // Abrir al pasar el ratón: tras 3s sobre una tarjeta con enlace,
    // se navega a su web. Salir del hover cancela la cuenta atrás.
    const COUNTDOWN_MS = 3000;
    const RING_LENGTH = 2 * Math.PI * 20; // r=20, matches the SVG

    document
        .querySelectorAll<HTMLElement>(".edition-card[data-url]")
        .forEach((card) => {
            const url = card.dataset.url;
            const ring = card.querySelector<SVGCircleElement>(
                ".timer-progress",
            );
            if (!url || !ring) return;

            // Base state: the ring starts completely empty / El anillo
            // empieza totalmente vacío
            ring.style.strokeDasharray = `${RING_LENGTH}`;
            ring.style.strokeDashoffset = `${RING_LENGTH}`;
            let timer: number | undefined;

            const stop = () => {
                window.clearTimeout(timer);
                card.classList.remove("timer-running");
                ring.style.transition = "none";
                ring.style.strokeDashoffset = `${RING_LENGTH}`;
            };

            const start = () => {
                stop();
                card.classList.add("timer-running");
                // Reset without animating, then force a reflow so the
                // transition always runs from the empty state.
                // Reinicio sin animar y reflow forzado para que la transición
                // arranque siempre desde el estado vacío.
                ring.style.transition = "none";
                ring.style.strokeDashoffset = `${RING_LENGTH}`;
                void ring.getBoundingClientRect();
                ring.style.transition = `stroke-dashoffset ${COUNTDOWN_MS}ms linear`;
                ring.style.strokeDashoffset = "0";
                timer = window.setTimeout(() => {
                    window.location.href = url;
                }, COUNTDOWN_MS);
            };

            card.addEventListener("mouseenter", start);
            card.addEventListener("mouseleave", stop);
            // Leaving the window, or coming back via the back/forward cache,
            // must never leave the ring stuck on screen / Ni al cambiar de
            // pestaña ni al volver con la caché del navegador debe quedar el
            // anillo visible
            window.addEventListener("blur", stop);
            window.addEventListener("pageshow", stop);
        });
</script>

<style>
    .picker {
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 24px 24px 48px;
        text-align: center;
    }

    /* --- Head / Cabecera --- */
    .picker-head {
        animation: rise 0.8s var(--ap-ease) both;
    }

    .picker-head h1 {
        margin: 24px 0 10px;
        font-family: var(--font-display);
        font-size: clamp(2.75rem, 7vw, 4.25rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.05;
        color: var(--text-primary);
    }

    .picker-head p {
        margin: 0 0 56px;
        font-size: clamp(1.15rem, 2.6vw, 1.4rem);
        font-weight: 500;
        color: var(--text-secondary);
    }

    /* --- Horizontal card list / Lista horizontal de cards --- */
    .editions {
        list-style: none;
        display: flex;
        justify-content: center;
        justify-content: safe center;
        gap: 24px;
        margin: 0;
        padding: 0;
    }

    .edition {
        flex: none;
        width: 300px;
        display: flex;
        animation: rise 0.8s var(--ap-ease) both;
    }

    .edition:nth-child(1) {
        animation-delay: 0.08s;
    }

    .edition:nth-child(2) {
        animation-delay: 0.18s;
    }

    .edition:nth-child(3) {
        animation-delay: 0.28s;
    }

    .edition-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
        padding: 32px;
        border-radius: 22px;
        background: var(--bg-card);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
        text-align: left;
        text-decoration: none;
        color: var(--text-primary);
        transition:
            transform 0.4s var(--ap-ease),
            box-shadow 0.4s var(--ap-ease);
    }

    a.edition-card:hover,
    a.edition-card:focus-visible {
        transform: translateY(-6px);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.1);
    }

    a.edition-card:focus-visible {
        outline: 3px solid var(--accent-blue);
        outline-offset: 3px;
    }

    .edition-logo {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        margin-bottom: 20px;
    }

    .edition-name {
        margin: 0 0 8px;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text-primary);
    }

    .edition-desc {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    /* CTA only on the available edition / CTA solo en la edición disponible */
    .edition-cta {
        margin-top: auto;
        padding-top: 24px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--accent-blue);
    }

    .edition-cta svg {
        transition: transform 0.3s var(--ap-ease);
    }

    .edition-card:hover .edition-cta svg {
        transform: translateX(3px);
    }

    /* --- Hover countdown ring / Anillo de cuenta atrás al hover --- */
    .card-timer {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.2s ease,
            visibility 0.2s ease;
    }

    .timer-running .card-timer {
        opacity: 1;
        visibility: visible;
    }

    .card-timer svg {
        filter: drop-shadow(0 6px 18px rgba(0, 0, 0, 0.12));
    }

    .timer-track {
        fill: rgba(255, 255, 255, 0.9);
        stroke: rgba(0, 0, 0, 0.08);
        stroke-width: 3;
    }

    .timer-progress {
        fill: none;
        stroke: var(--accent-blue);
        stroke-width: 3;
        stroke-linecap: round;
        transform: rotate(-90deg);
        transform-origin: center;
    }

    /* --- Upcoming row: dimmed and disabled / Fila en camino: atenuada --- */
    .upcoming {
        margin-top: 56px;
        animation: rise 0.8s var(--ap-ease) both;
        animation-delay: 0.2s;
    }

    .upcoming-caption {
        margin: 0 0 18px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        opacity: 0.8;
    }

    .upcoming .edition-card {
        opacity: 0.55;
        cursor: default;
        box-shadow: none;
        border: 1px solid var(--border-color);
    }

    .upcoming .edition-logo {
        filter: grayscale(30%);
    }

    /* Apple ease / Curva de Apple */
    .picker {
        --ap-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* --- Entrance animation / Animación de entrada --- */
    @keyframes rise {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .picker-head,
        .edition,
        .upcoming {
            animation: none;
        }

        .edition-card,
        .edition-cta svg,
        .card-timer {
            transition: none;
        }
    }

    /* --- Small screens: horizontal snap scroll / Móvil: carrusel horizontal --- */
    @media (max-width: 820px) {
        .editions {
            justify-content: flex-start;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            margin: 0 -24px;
            padding: 4px 24px 16px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .editions::-webkit-scrollbar {
            display: none;
        }

        .edition {
            scroll-snap-align: center;
        }

        .upcoming {
            margin-top: 40px;
        }
    }
</style>
