---
// Linktree-style homepage / Página de inicio tipo linktree
// The other Pulsar OS editions are not published yet, so the homepage
// points visitors to Bitten Fruit (bittenfruit.inled.es), the one that ships
// today, plus the usual community and documentation links.
import Layout from "../layouts/Layout.astro";

const BITTEN_FRUIT = "https://bittenfruit.inled.es";

const DISCORD = "https://link.inled.es/discord";
const MATRIX = "https://matrix.to/#/!POXBFohLnmrKwRBxTi:matrix.org?via=matrix.org";
const TELEGRAM = "https://link.inled.es/telegram";
const GITHUB = "https://github.com/Inled-Pulsar-OS";

// Links shown on the linktree, in order / Enlaces mostrados en el linktree
const LINKS = [
    {
        href: BITTEN_FRUIT,
        label: "Discover Bitten Fruit",
        hint: "The macOS experience on Linux, available today",
        icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>`,
    },
    {
        href: "/new-to-linux",
        label: "New to Linux? Start here",
        hint: "What changes and how to use Bitten Fruit",
        icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>`,
    },
    {
        href: "/help",
        label: "Help & documentation",
        hint: "Install, use and contribute",
        icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>`,
    },
    {
        href: "/community",
        label: "Community",
        hint: "Bugs, ideas, tasks and roadmap",
        icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    },
];

// Upcoming editions, not links yet / Ediciones que están en camino
const SOON = [
    { name: "Wintux", desc: "The Windows flow you know, minus the nagging." },
    { name: "Tube OS", desc: "Turn an old computer into the center of the living room." },
];
---

<Layout pageKey="index">
    <section class="lt-hero" aria-label="Pulsar OS">
        <div class="lt-hero-inner">
            <img
                src="https://hosted.inled.es/pulsar-logo-simple-sf.png"
                alt="Pulsar OS logo"
                class="lt-logo"
            />
            <h1 class="lt-title">Pulsar OS</h1>
            <p class="lt-lead">
                Linux so easy you already know how to use it. Today the way in is
                <strong>Bitten Fruit</strong>, the macOS experience on Linux.
            </p>
        </div>
    </section>

    <section class="lt-links" aria-label="Links">
        <div class="container lt-links-inner">
            <a href={BITTEN_FRUIT} class="lt-card lt-featured">
                <img
                    src="https://hosted.inled.es/pulsar-mac.png"
                    alt="Bitten Fruit logo"
                    class="lt-featured-logo"
                />
                <div class="lt-featured-body">
                    <h2 class="lt-featured-title">Meet Bitten Fruit</h2>
                    <p class="lt-featured-desc">
                        The macOS experience on Linux
                    </p>
                    <span class="lt-featured-cta">
                        Go to bittenfruit.inled.es
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </span>
                </div>
            </a>

            {LINKS.map((link) => (
                <a href={link.href} class="lt-card lt-row">
                    <span class="lt-row-icon" aria-hidden="true" set:html={link.icon} />
                    <span class="lt-row-text">
                        <span class="lt-row-title">{link.label}</span>
                        {link.hint && <span class="lt-row-hint">{link.hint}</span>}
                    </span>
                    <svg class="lt-row-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            ))}
        </div>
    </section>

    <section class="lt-soon" aria-label="Upcoming editions">
        <div class="container">
            <h2 class="lt-soon-heading">More editions on their way</h2>
            <div class="lt-soon-grid">
                {SOON.map((edition) => (
                    <div class="lt-soon-card">
                        <h3 class="lt-soon-name">{edition.name}</h3>
                        <p class="lt-soon-desc">{edition.desc}</p>
                        <span class="lt-soon-badge">Soon</span>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="lt-community" aria-label="Community">
        <div class="container">
            <h2 class="lt-community-heading">Say hi to the humans behind it</h2>
            <div class="lt-community-channels">
                <a href={DISCORD} target="_blank" rel="noopener noreferrer" class="lt-social">
                    <i class="fa-brands fa-discord" aria-hidden="true"></i>
                    <span>Discord</span>
                </a>
                <a href={MATRIX} target="_blank" rel="noopener noreferrer" class="lt-social">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="18" height="18" aria-hidden="true">
                        <path fill="currentColor" d="M61.6 27l-32.9 0 0 458 32.9 0 0 11-45.6 0 0-480 45.6 0 0 11zM496 496l-45.6 0 0-11 32.9 0 0-458-32.9 0 0-11 45.6 0 0 480zM324.1 167.6c9 0 17.4 1.1 25.2 3.3s14.3 5.7 19.8 10.6 9.8 11.2 12.9 19c3 7.8 4.6 17.3 4.6 28.3l0 114.5-47 0 0-97c0-5.7-.2-11.2-.6-16.3s-1.7-9.5-3.6-13.2c-2-3.8-4.9-6.8-8.7-9s-9.1-3.3-15.7-3.3c-6.6 0-12 1.3-16.1 3.8-4.1 2.6-7.3 5.8-9.6 10-2.3 4.1-3.9 8.7-4.6 13.9-.7 5.2-1.2 10.4-1.2 15.7l0 95.3-47 0 0-96c0-5.1-.1-10.1-.4-15-.2-5-1.2-9.5-2.9-13.8-1.7-4.1-4.4-7.6-8.3-10.1s-9.5-3.8-17.1-3.8c-2.2 0-5.2 .5-8.8 1.5s-7.2 2.9-10.6 5.6-6.4 6.7-8.8 11.9-3.6 12-3.6 20.4l0 99.3-47 0 0-171.3 44.3 0 0 23.2 .7 0c6.2-8.9 13.7-15.7 22.3-20.5 8.7-4.9 18.7-7.3 30-7.3 10.8 0 20.7 2.1 29.6 6.3s15.7 11.6 20.4 22.2c5.1-7.5 12-14.1 20.7-19.8s19-8.6 30.9-8.6z"></path>
                    </svg>
                    <span>Matrix</span>
                </a>
                <a href={TELEGRAM} target="_blank" rel="noopener noreferrer" class="lt-social">
                    <i class="fa-brands fa-telegram" aria-hidden="true"></i>
                    <span>Telegram</span>
                </a>
                <a href={GITHUB} target="_blank" rel="noopener noreferrer" class="lt-social">
                    <i class="fa-brands fa-github" aria-hidden="true"></i>
                    <span>GitHub</span>
                </a>
            </div>
        </div>
    </section>
</Layout>
