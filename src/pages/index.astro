---
// Edition picker homepage on the shared layout / Inicio selector de ediciones
// sobre el layout compartido. Apple-style picker: title, the available
// edition (Bitten Fruit), the ecosystem row and a dimmed upcoming row.
// Cards open on click, with no hover countdown and no surprise navigation.
// Selector estilo Apple: título, la edición disponible (Bitten Fruit), la
// fila de ecosistema y una fila atenuada con las que llegan pronto.
// Las tarjetas se abren al hacer clic: sin cuenta atrás al pasar el ratón.
import Layout from "../layouts/Layout.astro";
import { getLocale, localizePath } from "../i18n/config";
import { getContent } from "../i18n";

const locale = getLocale(Astro.url.pathname);
const t = getContent(locale);

// Available editions / Ediciones disponibles
const AVAILABLE = [
    {
        name: "Bitten Fruit",
        desc: t.index.editions.bitten.desc,
        logo: "/assets/bitten-fruit/desktop.png",
        href: "https://bittenfruit.inled.es",
        cta: t.index.visitSite,
    },
];

// Ecosystem apps / Aplicaciones del ecosistema
const APPS = [
    {
        name: "Sayri",
        desc: t.index.editions.sayri.desc,
        logo: "https://hosted.inled.es/cdn/sayri.png",
        href: "https://sayri.inled.es/",
        cta: t.index.discover,
    },
    {
        name: "Pulsar Phone",
        desc: t.index.editions.phone.desc,
        logo: "https://hosted.inled.es/cdn/pulsar-phone-logo-pulsarphone.png",
        href: "https://github.com/Inled-Pulsar-OS/pulsar-phone",
        cta: t.index.repo,
    },
];

// Upcoming editions: shown disabled / En camino: se muestran desactivadas
const UPCOMING = [
    {
        name: "Wintux",
        desc: t.index.editions.wintux.desc,
        logo: "https://hosted.inled.es/cdn/pulsar-win11-nobg.png",
    },
    {
        name: "Tube OS",
        desc: t.index.editions.tube.desc,
        logo: "https://hosted.inled.es/cdn/tube-os-simple-sf.png",
    },
];

// Site sections / Secciones del sitio
const SECTIONS = [
    {
        name: t.chrome.nav.bittenFruit,
        desc: t.index.sections.bitten,
        href: localizePath("/bitten-fruit", locale),
    },
    {
        name: t.chrome.nav.docs,
        desc: t.index.sections.docs,
        href: "https://help.inled.es/docs/pulsar-os/",
    },
    {
        name: t.chrome.nav.downloads,
        desc: t.index.sections.downloads,
        href: "https://downloads-os.inled.es",
    },
    {
        name: t.chrome.nav.resources,
        desc: t.index.sections.resources,
        href: localizePath("/resources", locale),
    },
];
---

<Layout pageKey="index">
    <div class="picker">
        <header class="picker-head">
            <h1>Pulsar OS</h1>
            <p class="picker-lead">{t.index.lead}</p>
            <p class="picker-note" set:html={t.index.noteHtml} />
        </header>

        <ul class="editions">
            {AVAILABLE.map((edition) => (
                <li class="edition">
                    <a class="edition-card" href={edition.href}>
                        <img
                            src={edition.logo}
                            alt=""
                            width="64"
                            height="64"
                            class="edition-logo"
                            loading="eager"
                        />
                        <h2 class="edition-name">{edition.name}</h2>
                        <p class="edition-desc">{edition.desc}</p>
                        <span class="edition-cta">
                            {edition.cta}
                            <svg
                                width="14"
                                height="14"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </span>
                    </a>
                </li>
            ))}
        </ul>

        <section class="ecosystem" aria-labelledby="ecosystem-caption">
            <p class="ecosystem-caption" id="ecosystem-caption">{t.index.ecosystem}</p>

            <ul class="editions">
                {APPS.map((edition) => (
                    <li class="edition">
                        <a class="edition-card" href={edition.href}>
                            <img
                                src={edition.logo}
                                alt=""
                                width="64"
                                height="64"
                                class="edition-logo"
                                loading="eager"
                            />
                            <h2 class="edition-name">{edition.name}</h2>
                            <p class="edition-desc">{edition.desc}</p>
                            <span class="edition-cta">
                                {edition.cta}
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <line x1="5" y1="12" x2="19" y2="12" />
                                    <polyline points="12 5 19 12 12 19" />
                                </svg>
                            </span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>

        <section class="upcoming" aria-labelledby="upcoming-caption">
            <p class="upcoming-caption" id="upcoming-caption">{t.index.comingSoon}</p>
            <ul class="editions">
                {UPCOMING.map((edition) => (
                    <li class="edition">
                        <div class="edition-card edition-soon" aria-disabled="true">
                            <img
                                src={edition.logo}
                                alt=""
                                width="64"
                                height="64"
                                class="edition-logo"
                                loading="lazy"
                            />
                            <h2 class="edition-name">{edition.name}</h2>
                            <p class="edition-desc">{edition.desc}</p>
                        </div>
                    </li>
                ))}
            </ul>
        </section>

        <section class="about" aria-labelledby="about-title">
            <h2 class="about-title" id="about-title">
                {t.index.aboutTitle}
            </h2>
            <p class="about-text">{t.index.aboutText}</p>

            <ul class="site-links">
                {SECTIONS.map((section) => (
                    <li>
                        <a class="site-link" href={section.href}>
                            <span class="site-link-name">{section.name}</span>
                            <span class="site-link-desc">{section.desc}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    </div>
</Layout>

<style>
    .picker {
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 24px 24px 48px;
        text-align: center;
    }

    /* --- Head / Cabecera --- */
    .picker-head {
        animation: rise 0.8s var(--ap-ease) both;
    }

    .picker-head h1 {
        margin: 24px 0 10px;
        font-family: var(--font-display);
        font-size: clamp(2.75rem, 7vw, 4.25rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.05;
        color: var(--text-primary);
    }

    .picker-lead {
        margin: 0 auto 12px;
        max-width: 700px;
        font-size: clamp(1.1rem, 2.4vw, 1.35rem);
        font-weight: 500;
        color: var(--text-secondary);
    }

    .picker-note {
        margin: 0 auto 56px;
        max-width: 640px;
        font-size: 0.95rem;
        line-height: 1.55;
        color: var(--text-secondary);
        opacity: 0.85;
    }

    /* --- Horizontal card list / Lista horizontal de cards --- */
    .editions {
        list-style: none;
        display: flex;
        justify-content: center;
        justify-content: safe center;
        gap: 24px;
        margin: 0;
        padding: 0;
    }

    .edition {
        flex: none;
        width: 300px;
        display: flex;
        animation: rise 0.8s var(--ap-ease) both;
    }

    .edition:nth-child(1) {
        animation-delay: 0.08s;
    }

    .edition:nth-child(2) {
        animation-delay: 0.18s;
    }

    .edition:nth-child(3) {
        animation-delay: 0.28s;
    }

    .edition-card {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        width: 100%;
        padding: 32px;
        border-radius: 22px;
        background: var(--bg-card);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
        text-align: left;
        text-decoration: none;
        color: var(--text-primary);
        transition:
            transform 0.4s var(--ap-ease),
            box-shadow 0.4s var(--ap-ease);
    }

    a.edition-card:hover,
    a.edition-card:focus-visible {
        transform: translateY(-6px);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.1);
    }

    a.edition-card:focus-visible {
        outline: 3px solid var(--accent-blue);
        outline-offset: 3px;
    }

    .edition-logo {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        margin-bottom: 20px;
        object-fit: contain;
    }

    .edition-name {
        margin: 0 0 8px;
        font-family: var(--font-display);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--text-primary);
    }

    .edition-desc {
        margin: 0;
        font-size: 0.95rem;
        line-height: 1.5;
        color: var(--text-secondary);
    }

    /* CTA only on linked cards / CTA solo en las tarjetas con enlace */
    .edition-cta {
        margin-top: auto;
        padding-top: 24px;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.9rem;
        font-weight: 500;
        color: var(--accent-blue);
    }

    .edition-cta svg {
        transition: transform 0.3s var(--ap-ease);
    }

    .edition-card:hover .edition-cta svg {
        transform: translateX(3px);
    }

    /* --- Upcoming row: dimmed and disabled / Fila en camino: atenuada --- */
    .upcoming,
    .ecosystem {
        margin-top: 56px;
        animation: rise 0.8s var(--ap-ease) both;
        animation-delay: 0.2s;
    }

    .upcoming-caption,
    .ecosystem-caption {
        margin: 0 0 18px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        opacity: 0.8;
    }

    .upcoming .edition-card {
        opacity: 0.55;
        cursor: default;
        box-shadow: none;
        border: 1px solid var(--border-color);
    }

    .upcoming .edition-logo,
    .ecosystem .edition-logo {
        filter: grayscale(30%);
    }

    /* --- About + section links / Sobre el proyecto y enlaces --- */
    .about {
        margin-top: 72px;
        padding-top: 48px;
        border-top: 1px solid var(--border-color);
        text-align: left;
        animation: rise 0.8s var(--ap-ease) both;
        animation-delay: 0.25s;
    }

    .about-title {
        margin: 0 0 14px;
        font-family: var(--font-display);
        font-size: clamp(1.5rem, 3.4vw, 1.9rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text-primary);
        text-align: center;
    }

    .about-text {
        margin: 0 auto;
        max-width: 720px;
        font-size: 1rem;
        line-height: 1.65;
        color: var(--text-secondary);
        text-align: center;
    }

    .site-links {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 24px;
        max-width: 900px;
        margin: 36px auto 0;
        padding: 0;
    }

    /* Same look as the edition cards / Mismo aspecto que las cards */
    .site-link {
        display: flex;
        flex-direction: column;
        gap: 6px;
        height: 100%;
        padding: 32px;
        border-radius: 22px;
        background: var(--bg-card);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
        text-decoration: none;
        transition:
            transform 0.4s var(--ap-ease),
            box-shadow 0.4s var(--ap-ease);
    }

    .site-link:hover,
    .site-link:focus-visible {
        transform: translateY(-6px);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.1);
    }

    .site-link:focus-visible {
        outline: 3px solid var(--accent-blue);
        outline-offset: 3px;
    }

    .site-link-name {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .site-link-desc {
        font-size: 0.85rem;
        line-height: 1.45;
        color: var(--text-secondary);
    }

    /* Apple ease / Curva de Apple */
    .picker {
        --ap-ease: cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* --- Entrance animation / Animación de entrada --- */
    @keyframes rise {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .picker-head,
        .edition,
        .upcoming,
        .ecosystem,
        .about {
            animation: none;
        }

        .edition-card,
        .edition-cta svg {
            transition: none;
        }
    }

    /* --- Small screens: horizontal snap scroll / Móvil: carrusel horizontal --- */
    @media (max-width: 820px) {
        .editions {
            justify-content: flex-start;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            margin: 0 -24px;
            padding: 4px 24px 16px;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .editions::-webkit-scrollbar {
            display: none;
        }

        .edition {
            scroll-snap-align: center;
        }

        .upcoming {
            margin-top: 40px;
        }
    }
</style>
