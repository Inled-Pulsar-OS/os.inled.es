---
import Layout from "../layouts/Layout.astro";
import { downloadAvailability } from "@/utils/downloads";

const ISO_RELEASES = "https://github.com/Inled-Pulsar-OS/ISO/releases/latest";
const DOWNLOADS = downloadAvailability();
---

<Layout pageKey="iso">
    <div class="iso-page">
        <!-- Hero -->
        <section class="iso-hero">
            <div class="container iso-hero-inner">
                <h1 class="iso-hero-title">Download the ISO</h1>
                <p class="iso-hero-desc">
                    Please read all this information before starting. You may already know some parts, but it is good that you read these warnings.
                </p>
          <!--      <div class="iso-hero-actions">
                    <a href={ISO_RELEASES} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                        Go to GitHub downloads
                        <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </a>
                    <a href="/" class="btn btn-secondary">
                        Back to home
                    </a>
                </div>  -->
            </div>
        </section>

        <!-- Minimum requirements -->
        <section class="iso-section">
            <div class="container">
                <h2 class="section-title">Minimum requirements</h2>
                <p class="section-subtitle">
                    For Bitten Fruit: x86_64 hardware with at least the following.
                    These are the minimums, more is always better.
                </p>
                <div class="iso-req-grid">
                    <div class="iso-req-card">
                        <div class="iso-req-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="5" y="5" width="14" height="14" rx="2"></rect>
                                <rect x="9" y="9" width="6" height="6"></rect>
                                <line x1="9" y1="2" x2="9" y2="5"></line>
                                <line x1="15" y1="2" x2="15" y2="5"></line>
                                <line x1="9" y1="19" x2="9" y2="22"></line>
                                <line x1="15" y1="19" x2="15" y2="22"></line>
                                <line x1="2" y1="9" x2="5" y2="9"></line>
                                <line x1="2" y1="15" x2="5" y2="15"></line>
                                <line x1="19" y1="9" x2="22" y2="9"></line>
                                <line x1="19" y1="15" x2="22" y2="15"></line>
                            </svg>
                        </div>
                        <h3 class="iso-req-title">Memory</h3>
                        <p class="iso-req-value">8 GB RAM</p>
                    </div>

                    <div class="iso-req-card">
                        <div class="iso-req-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="22" y1="12" x2="2" y2="12"></line>
                                <path d="M5.45 5.11L2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
                                <line x1="6" y1="16" x2="6.01" y2="16"></line>
                                <line x1="10" y1="16" x2="10.01" y2="16"></line>
                            </svg>
                        </div>
                        <h3 class="iso-req-title">Storage</h3>
                        <p class="iso-req-value">30 GB free</p>
                    </div>

                    <div class="iso-req-card">
                        <div class="iso-req-icon">
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                                <rect x="9" y="9" width="6" height="6"></rect>
                                <line x1="9" y1="1" x2="9" y2="4"></line>
                                <line x1="15" y1="1" x2="15" y2="4"></line>
                                <line x1="9" y1="20" x2="9" y2="23"></line>
                                <line x1="15" y1="20" x2="15" y2="23"></line>
                                <line x1="20" y1="9" x2="23" y2="9"></line>
                                <line x1="20" y1="14" x2="23" y2="14"></line>
                                <line x1="1" y1="9" x2="4" y2="9"></line>
                                <line x1="1" y1="14" x2="4" y2="14"></line>
                            </svg>
                        </div>
                        <h3 class="iso-req-title">Processor</h3>
                        <p class="iso-req-value">5 cores, x86_64</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Editions -->
        <section class="iso-section">
            <div class="container">
                <h2 class="section-title">Arch or Debian, your choice</h2>
                <p class="section-subtitle">
                    Every edition ships on both bases. Pick the one that fits how you
                    use your computer.
                </p>
                <div class="iso-cards-grid">
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">Debian Edition</h3>
                        <p class="iso-info-desc">
                            Rock-solid and predictable. Packages change slowly, so
                            nothing breaks unexpectedly, but support for very recent
                            hardware (new GPUs, Wi-Fi cards...) can lag behind. Best
                            for older computers and anyone who values stability above
                            all.
                        </p>
                    </div>
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">Arch Edition</h3>
                        <p class="iso-info-desc">
                            Rolling release, always up to date with the newest drivers
                            and packages. Excellent compatibility with new hardware,
                            but updates ship constantly, so a version can introduce
                            changes. Best for modern computers.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Boot variants -->
        <section class="iso-section">
            <div class="container">
                <h2 class="section-title">rEFInd or GRUB, your hardware decides</h2>
                <p class="section-subtitle">
                    The ISO ships with both bootloaders. Pick the one your computer
                    supports.
                </p>
                <div class="iso-cards-grid">
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">rEFInd</h3>
                        <p class="iso-info-desc">
                            The closest to the Mac experience and the most comfortable
                            to use. It requires a computer with <strong>UEFI</strong> support, it will not boot on legacy BIOS.
                        </p>
                    </div>
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">GRUB</h3>
                        <p class="iso-info-desc">
                            The classic bootloader. Works on any machine, including <strong>legacy BIOS</strong>. Choose this if your computer
                            does not support UEFI.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Installers -->
        <section class="iso-section">
            <div class="container">
                <h2 class="section-title">Two installers included</h2>
                <p class="section-subtitle">
                    Every edition comes with two ways to install the system.
                </p>
                <div class="iso-cards-grid">
                    <div class="iso-info-card iso-card-recommended">
                        <h3 class="iso-info-title">Pulsar Installer</h3>
                        <p class="iso-info-desc">
                            Our own installer. More reliable, easier to use and the
                            one we recommend. Use it first.
                        </p>
                    </div>
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">Calamares</h3>
                        <p class="iso-info-desc">
                            Still being polished. It works as a <strong>fallback</strong>, if the Pulsar Installer fails
                            for any reason, try Calamares.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Flash the USB -->
        <section class="iso-section">
            <div class="container">
                <h2 class="section-title">Flash the USB correctly</h2>
                <p class="section-subtitle">
                    How you write the ISO to the USB drive matters.
                </p>
                <div class="iso-warn-card">
                    <h3 class="iso-warn-title">Support for Ventoy still in testing</h3>
                    <p class="iso-warn-desc">
                        If something is wrong, let us know and if so, implement the solution if you want.
                    </p>
                </div>
                <div class="iso-warn-card">
                    <h3 class="iso-warn-title">Don't use Balena Etcher</h3>
                    <p class="iso-warn-desc">
                        Balena Etcher is very picky and complains to a minimum. It gives more problems than an old car. We recommend using gnome-disks or any other.
                    </p>
                </div>
            </div>
        </section>

        <!-- After install -->
        <section class="iso-section">
            <div class="container">
                <h2 class="section-title">After installing: remove the USB</h2>
                <p class="section-subtitle">
                    The one step almost everyone forgets.
                </p>
                <div class="iso-warn-card iso-warn-highlight">
                    <h3 class="iso-warn-title">Unplug the USB before rebooting</h3>
                    <p class="iso-warn-desc">
                        Once the installer restarts your computer, remove the USB. You're probably fine if you forget, but it's best to remove it.
                    </p>
                </div>
            </div>
        </section>

        <!-- Which download is for you? / ¿Qué descarga es para ti? -->
        <section class="iso-section" id="download-versions">
            <div class="container">
                <h2 class="section-title">Which one should you download?</h2>
                <p class="section-subtitle">
                    Every release comes in four combinations. Pick by your hardware
                    and how new your computer is — or let the assistant below help.
                </p>

                <div class="iso-pick-grid">
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">rEFInd — if your PC uses UEFI</h3>
                        <p class="iso-info-desc">
                            Almost every computer from the last decade uses UEFI.
                            rEFInd is the closest to the Mac experience and the most
                            comfortable to use. If you are not sure and your computer
                            is not ancient, this is probably the one.
                        </p>
                    </div>
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">GRUB — if your PC uses legacy BIOS</h3>
                        <p class="iso-info-desc">
                            Old computers (roughly pre-2012) usually boot in legacy
                            BIOS mode. GRUB works on any machine, including those.
                            Choose this if rEFInd refuses to boot.
                        </p>
                    </div>
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">Debian — stability, older PCs</h3>
                        <p class="iso-info-desc">
                            Rock-solid and predictable. Packages change slowly, so
                            nothing breaks unexpectedly. The best choice if you value
                            stability or your computer is a few years old.
                        </p>
                    </div>
                    <div class="iso-info-card">
                        <h3 class="iso-info-title">Arch — always up to date, new PCs</h3>
                        <p class="iso-info-desc">
                            Rolling release with the newest drivers and packages.
                            The best choice if your computer is recent and you want
                            to always be on the latest version.
                        </p>
                    </div>
                </div>

                <!-- Ask the AI: UEFI or BIOS? -->
                <div class="iso-ai-card">
                    <h3 class="iso-ai-title">Not sure if your PC uses UEFI or BIOS?</h3>
                    <p class="iso-ai-desc">
                        Write your computer's brand and model below and ask Google's
                        AI. It will open with the question already written for you.
                    </p>
                    <div class="iso-ai-row">
                        <input
                            type="text"
                            id="ai-model-input"
                            class="iso-ai-input"
                            placeholder="e.g. Dell Inspiron 15 3520 / HP Pavilion x360"
                            aria-label="Your computer brand and model"
                        />
                        <button type="button" id="ai-model-btn" class="btn btn-primary">
                            Ask the AI
                            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>
                    </div>
                    <p class="iso-ai-note">
                        Opens Google AI Mode in a new tab with your question ready.
                    </p>
                </div>

                <!-- Live version list / Lista de versiones en vivo -->
                <h3 class="iso-versions-title">Available versions</h3>
                <div id="iso-versions" class="iso-versions">
                    <p class="iso-versions-loading">Loading versions…</p>
                </div>
                <button type="button" id="iso-versions-toggle" class="iso-versions-toggle" hidden>
                    Show older versions
                </button>
            </div>
        </section>
    </div>

</Layout>

<script>
    // Live version list from the releases manifest / Lista de versiones en vivo
    (async () => {
        const container = document.getElementById("iso-versions");
        if (!container) return;

        try {
            const res = await fetch("https://pulsaros-releases.pages.dev/releases.json");
            if (!res.ok) throw new Error(`HTTP ${res.status}`);
            const data = await res.json();
            const versions = data.versions ?? {};
            const entries = Object.entries(versions);
            if (!entries.length) throw new Error("no versions");

            const fmtSize = (bytes) => `${(bytes / 1024 ** 3).toFixed(1)} GB`;

            // Latest first / La última primero
            entries.sort(([a], [b]) => {
                if (a === data.latest_version) return -1;
                if (b === data.latest_version) return 1;
                return b.localeCompare(a);
            });

            const cards = entries.map(([version, bases]) => {
                const isLatest = version === data.latest_version;
                const rows: string[] = [];
                for (const [base, boots] of Object.entries(bases as Record<string, any>)) {
                    for (const [boot, files] of Object.entries(boots as Record<string, any>)) {
                        // Only link real .iso files; the manifest may also list
                        // squashfs artifacts under other fields.
                        const isoUrl: string | undefined =
                            files?.iso && files.iso.endsWith(".iso")
                                ? files.iso
                                : Object.values(files ?? {}).find(
                                      (u): u is string => typeof u === "string" && u.endsWith(".iso"),
                                  );
                        if (!isoUrl) continue;
                        const sqUrl: string | undefined =
                            files?.squashfs && files.squashfs.endsWith(".squashfs") ? files.squashfs : undefined;

                        const metaHtml = (file: any, withSha: boolean) => `
                            ${file?.size_bytes ? `<span>${fmtSize(file.size_bytes)}</span>` : ""}
                            ${withSha && file?.sha256 ? `<span class="iso-version-sha">SHA256</span>` : ""}
                        `;
                        const shaAttr = (file: any) =>
                            file?.sha256 ? `data-sha256="${file.sha256}"` : "";

                        rows.push(`
                            <div class="iso-version-row">
                                <div class="iso-version-label">
                                    <strong>${base}</strong> · ${boot}
                                </div>
                                <div class="iso-version-meta"></div>
                                <a
                                    href="${isoUrl}"
                                    class="btn btn-secondary iso-version-btn"
                                    rel="noopener noreferrer"
                                >Download ISO</a>
                            </div>
                            ${
                                sqUrl
                                    ? `
                            <details class="iso-sq-details">
                                <summary>Squashfs — for USB recovery</summary>
                                <div class="iso-version-row iso-sq-row">
                                    <div class="iso-version-label">
                                        <strong>${base}</strong> · ${boot} · squashfs
                                    </div>
                                    <div class="iso-version-meta">${metaHtml(files, true)}</div>
                                    <a
                                        href="${sqUrl}"
                                        class="btn btn-secondary iso-version-btn iso-sq-btn"
                                        ${shaAttr(files)}
                                        rel="noopener noreferrer"
                                    >Download squashfs</a>
                                </div>
                            </details>
                            `
                                    : ""
                            }
                        `);
                    }
                }
                return `
                    <div class="iso-version-card${isLatest ? " is-latest" : ""}">
                        <div class="iso-version-head">
                            <h4 class="iso-version-name">${version}</h4>
                            ${isLatest ? '<span class="iso-version-badge">Latest</span>' : ""}
                        </div>
                        ${rows.join("")}
                    </div>
                `;
            });

            // Latest visible, older versions collapsed / Última visible, el resto plegado
            if (cards.length > 1) {
                const toggle = document.getElementById("iso-versions-toggle");
                container.innerHTML = cards.slice(0, 1).join("");
                if (toggle) {
                    toggle.hidden = false;
                    toggle.addEventListener("click", () => {
                        const expanded = toggle.getAttribute("aria-expanded") === "true";
                        if (expanded) {
                            container.innerHTML = cards.slice(0, 1).join("");
                            toggle.textContent = "Show older versions";
                            toggle.setAttribute("aria-expanded", "false");
                        } else {
                            container.innerHTML = cards.join("");
                            toggle.textContent = "Show fewer versions";
                            toggle.setAttribute("aria-expanded", "true");
                        }
                    });
                }
            } else {
                container.innerHTML = cards.join("");
            }

            // SHA256 copy buttons / Botones para copiar el SHA256
            container.querySelectorAll(".iso-version-sha").forEach((el) => {
                (el as HTMLElement).addEventListener("click", (event) => {
                    const card = (event.currentTarget as HTMLElement).closest(".iso-version-row");
                    const sha = card?.querySelector("[data-sha256]")?.getAttribute("data-sha256");
                    if (!sha) return;
                    navigator.clipboard.writeText(sha);
                    (event.currentTarget as HTMLElement).textContent = "Copied!";
                    setTimeout(() => {
                        (event.currentTarget as HTMLElement).textContent = "SHA256";
                    }, 1500);
                });
            });
        } catch {
            container.innerHTML =
                '<p class="iso-versions-loading">Could not load the version list. Get the latest release from <a href="https://github.com/Inled-Pulsar-OS/ISO/releases/latest" target="_blank" rel="noopener noreferrer">GitHub</a> or <a href="https://pulsaros-releases.pages.dev/releases.json" target="_blank" rel="noopener noreferrer">the manifest</a>.</p>';
        }
    })();

    // UEFI/BIOS AI helper / Asistente UEFI o BIOS
    (() => {
        const btn = document.getElementById("ai-model-btn");
        const input = document.getElementById("ai-model-input") as HTMLInputElement | null;
        if (!btn || !input) return;

        const go = () => {
            const model = input.value.trim();
            if (!model) {
                input.focus();
                return;
            }
            const prompt =
                `Does a ${model} computer use UEFI or legacy BIOS to boot? Answer briefly and tell me how to check it myself.`;
            const url = `https://www.google.com/search?q=${encodeURIComponent(prompt)}&udm=50`;
            window.open(url, "_blank", "noopener,noreferrer");
        };

        btn.addEventListener("click", go);
        input.addEventListener("keydown", (event) => {
            if (event.key === "Enter") go();
        });
    })();
</script>

<style>
    .iso-page {
        padding-top: 80px;
    }

    .iso-hero {
        padding: 80px 0 40px 0;
        text-align: center;
    }

    .iso-hero-inner {
        max-width: 720px;
        margin: 0 auto;
    }

    .iso-hero-title {
        font-family: var(--font-display);
        font-size: 3.5rem;
        font-weight: 700;
        letter-spacing: -2px;
        line-height: 1.05;
        margin-bottom: 20px;
        color: var(--text-primary);
    }

    .iso-hero-desc {
        font-size: 1.15rem;
        color: var(--text-secondary);
        line-height: 1.6;
        margin-bottom: 36px;
    }

    .iso-hero-actions {
        display: flex;
        gap: 16px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .iso-section {
        padding: 60px 0;
        border-top: 1px solid var(--border-color);
    }

    .iso-req-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 24px;
        max-width: 900px;
        margin: 0 auto;
    }

    .iso-req-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 40px 32px;
        text-align: center;
        transition: all var(--transition-speed) ease;
    }

    .iso-req-card:hover {
        border-color: var(--border-focus);
        background-color: var(--bg-card-hover);
        transform: translateY(-2px);
    }

    .iso-req-icon {
        width: 52px;
        height: 52px;
        margin: 0 auto 20px auto;
        border-radius: 16px;
        background: rgba(150, 108, 232, 0.08);
        border: 1px solid rgba(150, 108, 232, 0.15);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--accent-purple);
    }

    .iso-req-title {
        font-family: var(--font-display);
        font-size: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        margin-bottom: 8px;
    }

    .iso-req-value {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
    }

    .iso-cards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        max-width: 900px;
        margin: 0 auto;
    }

    .iso-info-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 40px 36px;
        transition: all var(--transition-speed) ease;
    }

    .iso-info-card:hover {
        border-color: var(--border-focus);
        background-color: var(--bg-card-hover);
    }

    .iso-card-recommended {
        border-color: rgba(103, 111, 248, 0.4);
    }

    .iso-info-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 12px;
        color: var(--text-primary);
    }

    .iso-info-desc {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.6;
    }

    .iso-info-desc a {
        color: var(--accent-blue);
        font-weight: 600;
    }

    .iso-info-desc strong {
        color: var(--text-primary);
    }

    .iso-warn-card {
        background-color: var(--bg-card);
        border: 1px solid rgba(234, 179, 8, 0.4);
        border-radius: 24px;
        padding: 40px 36px;
        max-width: 900px;
        margin: 0 auto 24px auto;
    }

    .iso-warn-highlight {
        border-color: rgba(239, 68, 68, 0.4);
        max-width: 900px;
    }

    .iso-warn-title {
        font-family: var(--font-display);
        font-size: 1.5rem;
        font-weight: 700;
        margin-bottom: 12px;
        color: var(--text-primary);
    }

    .iso-warn-desc {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.6;
    }

    .iso-flash-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 40px 36px;
        max-width: 900px;
        margin: 0 auto;
    }

    .iso-final-cta {
        padding-bottom: 100px;
    }

    .iso-download-card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 32px;
        padding: 80px 48px;
        text-align: center;
        max-width: 700px;
        margin: 0 auto;
    }

    .iso-download-title {
        font-family: var(--font-display);
        font-size: 2.5rem;
        font-weight: 700;
        letter-spacing: -1px;
        margin-bottom: 16px;
        color: var(--text-primary);
    }

    .iso-download-desc {
        font-size: 1.1rem;
        color: var(--text-secondary);
        margin-bottom: 32px;
        line-height: 1.6;
    }

    @media (max-width: 900px) {
        .iso-req-grid {
            grid-template-columns: 1fr;
            max-width: 420px;
        }

        .iso-cards-grid {
            grid-template-columns: 1fr;
            max-width: 480px;
        }
    }

