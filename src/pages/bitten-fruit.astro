    {
        iconSvg: I.sayri,
        title: "Sayri, AI assistant",
        desc: "An AI assistant that connects to whichever provider you want — like OpenClaw, but secure. It works perfectly with local models, and it never sends your data anywhere you didn't choose. Siri has never been this smart.",
    },
    {
        iconSvg: I.finder,
        title: "Finder, rebuilt",
        desc: "A true Finder clone: Nautilus completely rebuilt with Mac-style navigation, previews, tags and sidebar. Familiar from the first click.",
    },
    {
        iconSvg: I.cloud,
        title: "55 cloud providers",
        desc: "Up to 55 cloud storage providers supported natively inside Finder: Google Drive, Dropbox, OneDrive, Nextcloud and many more.",
    },
    {
        iconSvg: I.backup,
        title: "Time Machine",
        desc: "Copies of your whole system, stored wherever you want: a network server, any of the 50 cloud providers Finder supports, a USB stick… And if your computer ever breaks, restore everything from recovery.",
    },
    {
        iconSvg: I.shield,
        title: "Recovery system",
        desc: "Repair, reset or roll back Pulsar OS from a built-in recovery environment: over the internet if you've completely broken the system, or from a USB stick.",
    },
    {
        iconSvg: I.pkm,
        title: "PKM",
        desc: "Universal package manager. Install from pacman, apt, Flathub and AUR with natural commands.",
    },
    {
        iconSvg: I.store,
        title: "App store",
        desc: "Browse and install apps from all the package managers: Flathub, .deb, pacman and AUR. Update your system, uninstall any system package, clean system trash and run a virus scan.",
    },
    {
        iconSvg: I.spotlight,
        title: "Spotlight search",
        desc: "Search apps, documents, clipboard, images and any file. Navigate folders and uninstall apps from one search box.",
    },
    {
        iconSvg: I.circle,
        title: "Circle to Search",
        desc: "Shake the cursor and select whatever you see on screen: search it on Google, ask Sayri about it, or capture the text with OCR.",
    },
    {
        iconSvg: I.keyboard,
        title: "Keyboard remap",
        desc: "Are you more of a Mac universe or do you prefer to keep the Linux and Windows commands? No problem: change all shortcuts from Mac to Linux and vice versa.",
    },
    {
        iconSvg: I.windowmode,
        title: "Window mode",
        desc: "Full screen opens on a new workspace, the full macOS way. Snapping, grouping and gestures that feel natural.",
