---
// Bitten Fruit content moved to its own site: bittenfruit.inled.es
// Everything from here redirects there. / Todo lo de Bitten Fruit redirige a su web.
import Layout from "../layouts/Layout.astro";

const BITTEN_FRUIT_URL = "https://bittenfruit.inled.es";

const segments = Astro.url.pathname
    .split("/")
    .filter(Boolean)
    .slice(1)
    .join("/");

const redirectUrl = segments
    ? `${BITTEN_FRUIT_URL}/${segments}`
    : BITTEN_FRUIT_URL;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Bitten Fruit — moved to bittenfruit.inled.es</title>
        <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />
        <link rel="canonical" href={redirectUrl} />
    </head>
    <body>
        <p>
            Bitten Fruit now lives at
            <a href={redirectUrl}>{redirectUrl}</a>. Redirecting…
        </p>
    </body>
</html>