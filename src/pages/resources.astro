---
// Resources: logos and product demos hosted on hosted.inled.es.
// Recursos: logos y demos alojados en hosted.inled.es. Cada tarjeta enlaza a
// la ficha del asset (previsualización + descarga), sin iframes incrustados.
import Layout from "../layouts/Layout.astro";

const HOSTED = "https://hosted.inled.es";
const assetPage = (file: string) => `${HOSTED}/asset/${file}`;
const assetFile = (file: string) => `${HOSTED}/cdn/${file}`;

const LOGOS = [
    {
        name: "Pulsar OS",
        file: "pulsar-logo-simple-sf.png",
        thumb: "/resources/logos/pulsar-os.webp",
        meta: "PNG · 500 × 500 · 29 KB",
        transparent: true,
    },
    {
        name: "Tube OS",
        file: "tube-os-simple-sf.png",
        thumb: "/resources/logos/tube-os.webp",
        meta: "PNG · 2000 × 2000 · 1.3 MB",
        transparent: true,
    },
    {
        name: "Pulsar Phone",
        file: "pulsar-phone-logo-pulsarphone.png",
        thumb: "/resources/logos/pulsar-phone.webp",
        meta: "PNG · 192 × 192 · 7 KB",
        transparent: true,
    },
];

const DEMOS = [
    {
        title: "Touch ID & Face ID",
        file: "pulsar-demo-touch-face-id.mp4",
        thumb: "/resources/demos/touch-face-id.webp",
        meta: "MP4 · 8.3 MB",
    },
    {
        title: "Liquid Glass",
        file: "pulsar-liquid-glass-pulsar-demos.mp4",
        thumb: "/resources/demos/liquid-glass.webp",
        meta: "MP4 · 600 KB",
    },
    {
        title: "Live wallpapers",
        file: "pulsar-live-wallpaper-supra-demo.mp4",
        thumb: "/resources/demos/live-wallpaper.webp",
        meta: "MP4 · 4.3 MB",
    },
    {
        title: "Notch",
        file: "pulsaros-notch-pulsar-demos.mp4",
        thumb: "/resources/demos/notch.webp",
        meta: "MP4 · 288 KB",
    },
    {
        title: "Spotlight search",
        file: "pulsar-spotlight-pulsaros-demos.mp4",
        thumb: "/resources/demos/spotlight.webp",
        meta: "MP4 · 4.7 MB",
    },
    {
        title: "Global menu",
        file: "pulsar-global-menu-pulsar-demos.mp4",
        thumb: "/resources/demos/global-menu.webp",
        meta: "MP4 · 89 KB",
    },
    {
        title: "Window management",
        file: "pulsar-windows-pulsar-demos.mp4",
        thumb: "/resources/demos/windows-apps.webp",
        meta: "MP4 · 758 KB",
    },
    {
        title: "Firewall",
        file: "pulsar-firewall-pulsar-demos.mp4",
        thumb: "/resources/demos/firewall.webp",
        meta: "MP4 · 398 KB",
    },
    {
        title: "Encryption",
        file: "pulsar-demo-encryption-pulsaros.mp4",
        thumb: "/resources/demos/encryption.webp",
        meta: "MP4 · 33 KB",
    },
    {
        title: "Install apps from the Store",
        file: "appinstall-pulsar-pulsaros-demo-OK.mp4",
        thumb: "/resources/demos/app-install.webp",
        meta: "MP4 · 3.3 MB",
    },
];
---

<Layout pageKey="resources">
    <section class="resources-hero">
        <div class="container resources-heading">
            <h1 class="section-title">Resources</h1>
            <p class="section-subtitle">
                Logos and product demos to share Pulsar OS on social media.
                Every file opens on hosted.inled.es, where you can preview it
                and download it.
            </p>
        </div>
    </section>

    <section class="resources-share-notice">
        <div class="container">
            <div class="resources-share-card">
                <div class="resources-share-content">
                    <h2 class="resources-share-title">Help us grow</h2>
                    <p class="resources-share-desc">
                        If you share about Pulsar OS on social networks, we will
                        find a way to reward your help to the project.
                    </p>
                </div>
                <a
                    href="https://link.inled.es/discord"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn btn-primary resources-share-btn">Share on social media</a
                >
            </div>
        </div>
    </section>

    <section class="res-section" aria-labelledby="logos-title">
        <div class="container">
            <div class="res-section-head">
                <h2 class="res-section-title" id="logos-title">Logos</h2>
                <p class="res-section-desc">
                    Transparent PNGs for covers, posts and articles.
                </p>
            </div>

            <ul class="logo-grid">
                {LOGOS.map((logo) => (
                    <li class="logo-card">
                        <a
                            class="logo-preview"
                            href={assetPage(logo.file)}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <img
                                src={logo.thumb}
                                alt={`${logo.name} logo`}
                                width="200"
                                height="200"
                                loading="lazy"
                            />
                        </a>
                        <div class="logo-info">
                            <h3 class="logo-name">{logo.name}</h3>
                            <p class="logo-meta">{logo.meta}</p>
                            <div class="logo-actions">
                                <a
                                    class="btn btn-primary res-btn"
                                    href={assetPage(logo.file)}
                                    target="_blank"
                                    rel="noopener noreferrer">Open</a
                                >
                                <a
                                    class="res-btn res-btn-ghost"
                                    href={assetFile(logo.file)}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    >Download</a
                                >
                            </div>
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="res-section" aria-labelledby="demos-title">
        <div class="container">
            <div class="res-section-head">
                <h2 class="res-section-title" id="demos-title">Demos</h2>
                <p class="res-section-desc">
                    Short clips of the features in action. Click one to preview
                    it and grab the MP4.
                </p>
            </div>

            <ul class="demo-grid">
                {DEMOS.map((demo) => (
                    <li class="demo-card">
                        <a
                            class="demo-thumb"
                            href={assetPage(demo.file)}
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            <img
                                src={demo.thumb}
                                alt={`${demo.title} demo`}
                                width="720"
                                height="405"
                                loading="lazy"
                            />
                            <span class="demo-play" aria-hidden="true">
                                <svg
                                    width="22"
                                    height="22"
                                    viewBox="0 0 24 24"
                                    fill="currentColor"
                                >
                                    <path d="M8 5v14l11-7z" />
                                </svg>
                            </span>
                        </a>
                        <div class="demo-info">
                            <div>
                                <h3 class="demo-name">{demo.title}</h3>
                                <p class="demo-meta">{demo.meta}</p>
                            </div>
                            <a
                                class="res-btn res-btn-ghost demo-download"
                                href={assetFile(demo.file)}
                                target="_blank"
                                rel="noopener noreferrer"
                                >MP4</a
                            >
                        </div>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="res-more">
        <div class="container">
            <p>
                Looking for something else? Browse
                <a href="https://hosted.inled.es/" target="_blank" rel="noopener noreferrer"
                    >hosted.inled.es</a
                >
                or ask us on Discord.
            </p>
        </div>
    </section>
</Layout>

<style>
    .resources-heading {
        text-align: center;
        max-width: 760px;
        margin: 0 auto;
    }

    .resources-hero {
        padding-bottom: 12px;
    }

    .resources-share-notice {
        padding-bottom: 48px;
    }

    .res-section {
        padding: 8px 0 56px;
    }

    .res-section-head {
        text-align: center;
        margin-bottom: 28px;
    }

    .res-section-title {
        margin: 0 0 8px;
        font-family: var(--font-display);
        font-size: clamp(1.6rem, 3.4vw, 2rem);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--text-primary);
    }

    .res-section-desc {
        margin: 0;
        font-size: 0.95rem;
        color: var(--text-secondary);
    }

    /* --- Logos --- */
    .logo-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 24px;
        margin: 0;
        padding: 0;
    }

    .logo-card {
        display: flex;
        flex-direction: column;
        border-radius: 22px;
        background: var(--bg-card);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        transition:
            transform 0.4s ease,
            box-shadow 0.4s ease;
    }

    .logo-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.1);
    }

    .logo-preview {
        display: grid;
        place-items: center;
        aspect-ratio: 16 / 10;
        padding: 24px;
        background: var(--bg-card-hover);
    }

    .logo-preview img {
        width: 128px;
        height: 128px;
        object-fit: contain;
    }

    .logo-info {
        padding: 20px 22px 22px;
    }

    .logo-name {
        margin: 0 0 4px;
        font-family: var(--font-display);
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .logo-meta,
    .demo-meta {
        margin: 0;
        font-size: 0.8rem;
        color: var(--text-secondary);
        opacity: 0.85;
    }

    .logo-actions {
        display: flex;
        gap: 8px;
        margin-top: 16px;
    }

    .res-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 500;
        text-decoration: none;
    }

    .res-btn-ghost {
        border: 1px solid var(--border-color);
        color: var(--text-primary);
        transition:
            background-color 0.2s ease,
            border-color 0.2s ease;
    }

    .res-btn-ghost:hover {
        background: var(--bg-card-hover);
        border-color: var(--border-focus);
    }

    /* --- Demos --- */
    .demo-grid {
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
        margin: 0;
        padding: 0;
    }

    .demo-card {
        display: flex;
        flex-direction: column;
        border-radius: 22px;
        background: var(--bg-card);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.05);
        overflow: hidden;
        transition:
            transform 0.4s ease,
            box-shadow 0.4s ease;
    }

    .demo-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.1);
    }

    .demo-thumb {
        position: relative;
        display: block;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--bg-card-hover);
    }

    .demo-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .demo-play {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        color: #fff;
        opacity: 0.9;
        transition: opacity 0.2s ease;
    }

    .demo-play svg {
        width: 44px;
        height: 44px;
        padding: 10px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.45);
        backdrop-filter: blur(6px);
    }

    .demo-thumb:hover .demo-play {
        opacity: 1;
    }

    .demo-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 20px;
    }

    .demo-name {
        margin: 0 0 2px;
        font-family: var(--font-display);
        font-size: 0.98rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .demo-download {
        flex-shrink: 0;
        padding: 6px 12px;
        font-size: 0.78rem;
    }

    .res-more {
        padding: 8px 0 24px;
        text-align: center;
    }

    .res-more p {
        margin: 0;
        font-size: 0.9rem;
        color: var(--text-secondary);
    }

    .res-more a {
        color: var(--accent-blue);
        text-decoration: none;
        font-weight: 500;
    }

    .res-more a:hover {
        text-decoration: underline;
    }

    @media (max-width: 800px) {
        .logo-grid,
        .demo-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
