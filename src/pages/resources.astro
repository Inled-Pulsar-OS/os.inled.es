---
import Layout from "../layouts/Layout.astro";
import { readdirSync } from "node:fs";
import { join } from "node:path";

const resourcesDir = join(import.meta.dirname, "..", "..", "public", "resources");

let files: string[] = [];
try {
    files = readdirSync(resourcesDir)
        .filter((f) => !f.startsWith("."))
        .sort((a, b) => a.localeCompare(b));
} catch {
    // Directory may not exist yet
}

const IMAGE_EXTS = [".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg"];
const isImage = (name: string) => IMAGE_EXTS.some((ext) => name.toLowerCase().endsWith(ext));

const prettyName = (filename: string) =>
    filename
        .replace(/\.[^.]+$/, "")
        .replace(/[-_]/g, " ")
        .replace(/\b\w/g, (c) => c.toUpperCase());

const fileUrl = (name: string) => `/resources/${name}`;

// Embedded media (e.g. hosted videos) rendered full-width in their own section.
const EMBEDS = [
    {
        src: "https://hosted.inled.es/asset/pulsar-logo-simple-sf.png",
        title: "Logo",
    },
    {
        src: "https://hosted.inled.es/asset/pulsar-phone-logo-pulsarphone.png",
        title: "Pulsar Phone Logo",
    },
];
---

<Layout pageKey="resources">
    <section class="resources-hero">
        <div class="container" style="text-align: center; max-width: 800px; margin: 0 auto;">
            <h1 class="section-title">Resources</h1>
            <p class="section-subtitle" style="margin-bottom: 0;">
                Download banners, logos and media assets to share Pulsar OS on social media.
            </p>
        </div>
    </section>

    <!-- Share CTA -->
    <section class="resources-share-notice">
        <div class="container">
            <div class="resources-share-card">
                <div class="resources-share-content">
                    <h3 class="resources-share-title">Help us grow</h3>
                    <p class="resources-share-desc">
                      If you share about Pulsar OS on social networks, we will find a way to reward your help to the project.
                    </p>
                </div>
                <a href="https://link.inled.es/discord" target="_blank" rel="noopener noreferrer" class="btn btn-primary resources-share-btn">
                    Share on social media
                </a>
            </div>
        </div>
    </section>

    <!-- Embedded media -->
    {
        EMBEDS.length > 0 && (
            <section class="resources-embeds-section">
                <div class="container">
                    {EMBEDS.map((embed) => (
                        <div class="resources-embed">
                            <h3 class="resources-embed-title">{embed.title}</h3>
                            <iframe
                                src={embed.src}
                                width="540"
                                height="540"
                                style="border:none;border-radius:12px;max-width:100%;"
                                title={embed.title}
                                loading="lazy"
                            ></iframe>
                        </div>
                    ))}
                </div>
            </section>
        )
    }
<div style="align-items: center; text-align: center;">
<p>For more resources go to <a href="https://hosted.inled.es/">hosted.inled.es</a> and search for "pulsar" or ask us</p>
</div>
</Layout>
