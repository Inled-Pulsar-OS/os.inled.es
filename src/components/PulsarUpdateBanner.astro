---
interface Props {}
---

<!-- Pulsar OS 2.0 Announcement Banner (Apple Blue) -->
<section
  id="pulsar-update-banner"
  class="bg-accent-blue text-accent-btn-text py-3 text-center text-sm font-medium select-none"
>
  <div class="max-w-7xl mx-auto px-4 flex items-center justify-center gap-3">
    <span>
      We&rsquo;re preparing the biggest update for Pulsar OS: version 2.0. We&rsquo;ll update this website soon.
    </span>
    <a
      href="https://link.inled.es/discord"
      target="_blank"
      rel="noopener noreferrer"
      class="underline underline-offset-4 hover:opacity-90 transition-opacity cursor-pointer inline-block"
    >
      Join Discord to stay up to date &rarr;
    </a>
  </div>
</section>

<style>
  /* Token fallbacks for the banner (repo uses plain CSS variables) */
  #pulsar-update-banner {
    background: var(--accent-blue, #0066cc);
    color: var(--accent-btn-text, #ffffff);
  }
  #pulsar-update-banner a {
    color: var(--accent-btn-text, #ffffff);
  }
</style>
